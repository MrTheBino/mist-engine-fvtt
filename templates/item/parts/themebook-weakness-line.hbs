<div class="item-weakness-line flexrow">
    <strong style="flex-grow:0.3;">{{questionIndexToLetter index}}</strong> 
    <input type="checkbox" class="planned-toggle" name="system.weaknesstags.{{index}}.planned" style="flex-grow:0.3;" title="{{localize "MIST_ENGINE.HELP.Titles.PlannedPowertag"}}"  {{#if weakness.planned}}checked{{/if}}/>
    <input type="checkbox" name="system.weaknesstags.{{index}}.burned" {{#if weakness.burned}}checked{{/if}} style="display: none;"/>
    <div  style="flex-grow:8;">
        <input type="text" name="system.weaknesstags.{{index}}.question" value="{{weakness.question}}" title="{{localize 'MIST_ENGINE.UI.QuestionTitle' letter=(questionIndexToLetter index)}}" placeholder="{{weaknessTagQuestionPlaceholder index weakness.question}}"/>
        <input type="text" name="system.weaknesstags.{{index}}.name" value="{{weakness.name}}" title="{{questionIndexToLetter index}} - {{localize 'MIST_ENGINE.PLACEHOLDERS.Tag'}}" placeholder="{{localize 'MIST_ENGINE.UI.AnswerTheTag'}}" />
    </div>
    <i class="fa-solid fa-trash clickable" data-action="deleteWeaknessTag" data-index="{{index}}" style="flex-grow:0.3; margin-left: 0.5em;" title="{{localize "MIST_ENGINE.HELP.DeleteWeaknessTag"}}"></i>
</div>