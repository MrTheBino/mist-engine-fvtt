<header class="item-header">
    <div class="flexrow">
        <img class="item-img" data-action="editImage" src="{{item.img}}" data-edit="img" title="{{item.name}}"
            height="60" style="flex-grow: 0.25;" />
        <div class="flexcol">
            <h2 class="item-name" style="flex-grow: 4;"><input name="name" type="text" value="{{item.name}}"
                    placeholder="{{localize 'MIST_ENGINE.LABELS.Name'}}" /></h2>
            <div class="flexrow">
                <input type="text" name="system.themekit_type" value="{{item.system.themekit_type}}"
                    placeholder="{{localize 'MIST_ENGINE.UI.ThemekitTypeExample'}}" />
                <div class="flexrow">
                    <label style="flex-grow: 0.2;"><strong>{{localize 'MIST_ENGINE.UI.Type'}}</strong></label>
                    <select name="system.themebook_type" style="flex-grow: 1;">
                        <option value="">-</option>
                        <option value="litm-origin" {{#if (eq system.themebook_type "litm-origin" )}}selected{{/if}}>{{localize 'MIST_ENGINE.UI.LitMOrigin'}}</option>
                        <option value="litm-adventure" {{#if (eq system.themebook_type "litm-adventure"
                            )}}selected{{/if}}>{{localize 'MIST_ENGINE.UI.LitMAdventure'}}</option>
                        <option value="litm-variable" {{#if (eq system.themebook_type "litm-variable"
                            )}}selected{{/if}}>{{localize 'MIST_ENGINE.UI.LitMVariable'}}</option>
                        <option value="litm-greatness" {{#if (eq system.themebook_type "litm-greatness"
                            )}}selected{{/if}}>{{localize 'MIST_ENGINE.UI.LitMGreatness'}}</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</header>